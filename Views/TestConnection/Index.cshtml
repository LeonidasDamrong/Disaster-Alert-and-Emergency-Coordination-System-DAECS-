@{
	ViewData["Title"] = "Database Connection Test";
}

<div class="container mt-5">
	<div class="card">
		<div class="card-header bg-primary text-white">
			<h3><i class="bi bi-database"></i> Azure SQL Database Connection Test</h3>
		</div>
		<div class="card-body">
			@if (ViewBag.Status == "success")
			{
				<div class="alert alert-success">
					<h4>✅ @ViewBag.Message</h4>
				</div>

				<div class="row mt-4">
					<div class="col-md-6">
						<div class="card">
							<div class="card-body">
								<h5>Connection Details</h5>
								<hr>
								<p><strong>Server:</strong><br>@ViewBag.Server</p>
								<p><strong>Database:</strong><br>@ViewBag.Database</p>
								<p><strong>Registered Users:</strong> @ViewBag.UserCount</p>
							</div>
						</div>
					</div>
					<div class="col-md-6">
						<div class="card">
							<div class="card-body">
								<h5>Database Tables</h5>
								<hr>
								@if (ViewBag.Tables != null)
								{
									<ul class="list-unstyled">
										@foreach (var table in ViewBag.Tables)
										{
											<li>✓ @table</li>
										}
									</ul>
								}
							</div>
						</div>
					</div>
				</div>
			}
			else
			{
				<div class="alert alert-danger">
					<h4>❌ @ViewBag.Message</h4>
					@if (ViewBag.InnerException != null)
					{
						<hr>
						<p><strong>Details:</strong> @ViewBag.InnerException</p>
					}
				</div>

				<div class="alert alert-info mt-3">
					<h5>Troubleshooting:</h5>
					<ul>
						<li>Check if your IP is allowed in Azure SQL firewall</li>
						<li>Verify connection string in appsettings.json</li>
						<li>Ensure password is correct</li>
						<li>Check if Azure SQL Server is running</li>
					</ul>
				</div>
			}

			<div class="mt-4">
				<a asp-controller="Home" asp-action="Index" class="btn btn-primary">
					<i class="bi bi-house"></i> Go to Home
				</a>
			</div>
		</div>
	</div>
</div>
